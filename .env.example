# 프론트엔드에서 사용하는 Supabase 공개 설정입니다.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 선택 사항: 별도 프록시를 쓸 때만 지정합니다.
# 기본값은 Supabase Edge Function /functions/v1/tutor 입니다.
VITE_TUTOR_API_URL=

# Apps in Toss 광고 그룹 ID입니다. 콘솔에서 광고 그룹을 만든 뒤 입력합니다.
# 개발 중에는 공식 테스트 ID를 사용하고, 출시 전에는 발급받은 운영 ID로 교체하세요.
VITE_TOSS_AD_BANNER_GROUP_ID=
VITE_TOSS_AD_INTERSTITIAL_GROUP_ID=
VITE_TOSS_AD_REWARDED_GROUP_ID=

# 콘솔에서 승인받은 기능성 스마트 발송 템플릿 코드입니다.
# 예: japanese-lingo-daily-study
# 비워 두면 첫 레슨 완료 후 알림 동의 카드가 표시되지 않습니다.
VITE_TOSS_NOTIFICATION_TEMPLATE_CODE=

# GEMINI_API_KEY와 DAILY_NEWS_CRON_SECRET은 이 파일에 넣지 않습니다.
# 둘 다 Supabase Edge Function Secret으로 등록하세요.
